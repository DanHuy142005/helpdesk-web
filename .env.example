# Copy to .env only when using an existing PostgreSQL server.
# Without DATABASE_URL, npm run dev starts persistent local PostgreSQL on port 55432.
DATABASE_URL=postgresql://nexdesk_app:CHANGE_ME@127.0.0.1:5432/nexdesk
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Optional SMS gateway. Without a gateway the configured fixed OTP is verified locally.
# POST JSON {phone,message}; expects a successful HTTP response.
# SMS_WEBHOOK_URL=https://your-sms-service.example/messages
# SMS_API_KEY=configure-on-the-server
